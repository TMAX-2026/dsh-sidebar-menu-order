{
  "name": "dsh-sidebar-menu-order",
  "version": "1.0.3",
  "description": "Reorder the left navigation menu of the DeepSeek Harness web GUI by dragging, and keep the order in the active profile.",
  "author": "TMAX-2026",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMAX-2026/dsh-sidebar-menu-order.git"
  },
  "homepage": "https://github.com/TMAX-2026/dsh-sidebar-menu-order#readme",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "menu",
    "reorder",
    "drag"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2 || >=3.18.6-alpha.2 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
