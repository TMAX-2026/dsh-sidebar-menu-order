  "plugins": [
    {
      "name": "dsh-sidebar-menu-order",
      "title": {
        "en": "Sidebar menu order",
        "zh": "侧栏菜单顺序"
      },
      "description": {
        "en": "Rearranges the left menu (Plugins, Automations, chat and context panels) by dragging, and keeps the order in the active profile. Open More at the bottom of the left menu, choose Reorder menu, then drag a row or use its arrow buttons; the order persists across restarts because it is stored in the profile's settings document.",
        "zh": "用拖拽调整左侧菜单（插件、自动化任务、聊天、上下文洞察等面板）的先后顺序，并按当前 profile 保存。打开左侧面板列表末尾的「更多」，选择「菜单排序…」，拖动行或点行上的上下箭头即可；顺序写入 profile 的设置文档，重启后仍然有效。"
      },
      "icon": "data:image/svg+xml;base64,",
      "author": "TMAX-2026",
